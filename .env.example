# Optional API keys (server works without any of these)
OPENWEATHERMAP_API_KEY=
WEATHERAPI_KEY=
TOMORROW_IO_API_KEY=

# Cache settings
CACHE_TTL_MINUTES=60
CACHE_MAX_ENTRIES=200
CACHE_MAX_INFLIGHT=64

# HTTP timeout
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RESPONSE_BYTES=8388608
HTTP_MAX_CONCURRENT=8
HTTP_MAX_QUEUED=64
MAX_HTTP_REQUESTS=8

# Docker published address: change only for a trusted network/proxy
MCP_BIND_ADDRESS=127.0.0.1

# HTTP mode: extra browser origins allowed to call /mcp (comma-separated)
ALLOWED_ORIGINS=

# off = no one-time note about missing optional API keys
MCP_WEATHER_KEY_NOTE=
