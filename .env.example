# Optional API keys (server works without any of these)
OPENWEATHERMAP_API_KEY=
WEATHERAPI_KEY=
TOMORROW_IO_API_KEY=

# Cache settings
CACHE_TTL_MINUTES=60
CACHE_MAX_ENTRIES=200
CACHE_MAX_INFLIGHT=64
CACHE_MAX_BYTES=16777216
METADATA_CACHE_MAX_ENTRIES=128
METADATA_CACHE_MAX_BYTES=8388608

# Writable private durable state. Docker image uses /var/lib/mcp-weather and a named volume.
# For native/stdio, default is ~/.cache/mcp-weather. Keep across upgrades.
# MCP_STATE_DIR=/path/to/private/weather-state

# Application safety ceilings, NOT provider entitlements. Lower for your account and other consumers.
# Values can override minute/hour/day/month per provider; minute/hour are rolling, day/month UTC.
# Separate hosts/volumes have separate budgets: split any shared account allowance between them.
WEATHER_QUOTAS_JSON=

# stdio only: full (default) or compact. HTTP offers both /mcp and /mcp/compact.
MCP_PROFILE=full

# HTTP timeout
HTTP_TIMEOUT_MS=10000
HTTP_MAX_RESPONSE_BYTES=8388608
HTTP_MAX_CONCURRENT=8
HTTP_MAX_QUEUED=64
MAX_HTTP_REQUESTS=8

# Docker published address: change only for a trusted network/proxy
MCP_BIND_ADDRESS=127.0.0.1

# HTTP mode: extra browser origins allowed to call /mcp (comma-separated)
ALLOWED_ORIGINS=

# off = no one-time note about missing optional API keys
MCP_WEATHER_KEY_NOTE=
