    "open-meteo",
    "finland",
    "nordic",
    "europe",
    "astronomy",
    "streamable-http",
    "weather-warnings",
    "aurora",
    "nowcast",
    "met-norway",
    "smhi",
    "meteoalarm",
    "baltic"
  ],
  "homepage": "https://github.com/Koneisto/mcp-weather#readme",
  "bugs": {
    "url": "https://github.com/Koneisto/mcp-weather/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Koneisto/mcp-weather.git"
  },
  "license": "MIT",
  "author": "Koneisto <noreply@example.invalid>",
  "private": true,
  "type": "module",
